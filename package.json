{
  "name": "@altmanlib/preact-kit",
  "version": "0.8.0",
  "description": "Preact component library: generic components and light/dark design tokens, installed from GitHub, with a self-collecting gallery",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altmanlib/preact-kit.git"
  },
  "homepage": "https://github.com/altmanlib/preact-kit#readme",
  "bugs": {
    "url": "https://github.com/altmanlib/preact-kit/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./primitives/*": "./src/kit/primitives/*/index.tsx",
    "./patterns/*": "./src/kit/patterns/*/index.tsx",
    "./lib/*": "./src/kit/lib/*.ts",
    "./texts": "./src/kit/texts.ts",
    "./base.css": "./src/kit/base.css",
    "./tokens.css": "./src/kit/tokens.css",
    "./motion.css": "./src/kit/motion.css",
    "./assets": "./src/kit/assets.d.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "gen": "bun scripts/gen-demos.ts",
    "dev": "bun run gen && bun src/server.ts",
    "format": "bun fmt src scripts",
    "format:check": "bun fmt --check src scripts",
    "typecheck": "bun run gen && bun check",
    "test": "bun test ./src ./scripts --timeout 30000",
    "docs:check": "bun scripts/check-docs.ts",
    "ci": "bun run format:check && bun run typecheck && bun run docs:check && bun run test",
    "release": "bash scripts/release.sh",
    "merge-main": "bash scripts/merge-main.sh"
  },
  "dependencies": {
    "lucide-preact": "^1.63.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@preact/signals": "^2.11.4",
    "@tanstack/preact-query": "^5.105.0",
    "@types/bun": "^1.4.4",
    "preact": "^11.1.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.9",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@preact/signals": "^2.11.4",
    "@tanstack/preact-query": "^5.105.0",
    "preact": "^11.1.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.9"
  },
  "peerDependenciesMeta": {
    "@tanstack/preact-query": {
      "optional": true
    },
    "prosemirror-commands": {
      "optional": true
    },
    "prosemirror-history": {
      "optional": true
    },
    "prosemirror-keymap": {
      "optional": true
    },
    "prosemirror-model": {
      "optional": true
    },
    "prosemirror-state": {
      "optional": true
    },
    "prosemirror-view": {
      "optional": true
    }
  }
}
